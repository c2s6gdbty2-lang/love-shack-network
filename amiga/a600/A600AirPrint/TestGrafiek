; $VER: TestGrafiek 1.0 (16.10.2026) A600AirPrint
; Stap 2 van de printertest: een grafische afdruk via printer.device
; (MultiView drukt het testbeeld TestBeeld.iff af via ARexx PRINT).
FailAt 21
Echo "A600AirPrint - TestGrafiek (1 pagina, kleurenbeeld)"
Version >NIL: bsdsocket.library
IF WARN
  Echo "FOUT: het netwerk staat uit. Start eerst de Plipbox (AmiTCP) zoals altijd."
  Quit 20
EndIF
IF NOT EXISTS TestBeeld.iff
  Echo "FOUT: start vanuit Work:A600AirPrint of de diskette (TestBeeld.iff ontbreekt)."
  Quit 20
EndIF
IF NOT EXISTS Hulp/Poortcheck
  Echo "FOUT: start vanuit Work:A600AirPrint of de A600AirPrint-diskette."
  Quit 20
EndIF
Execute Hulp/Poortcheck
IF NOT "$APpc" EQ "ok"
  Execute Hulp/Poortmelding
  Quit 10
EndIF
Set APfast `Avail FAST`
IF NOT "$APfast" GT "1000000" VAL
  Echo "LET OP: minder dan 1 MB Fast RAM vrij. In de emulator lukte een"
  Echo "        kleurenpagina alleen met Fast RAM; zonder krijg je waarschijnlijk"
  Echo "        'User Cancelled Print Request' of 'not enough memory'."
EndIF
Echo "Op een 68000 (7 MHz) duurt de kleurenpagina ongeveer 10-11 minuten"
Echo "(MultiView staat dan op Printing...). De Amiga blijft bruikbaar."
RequestChoice >ENV:APSkeuze "TestGrafiek" "Het testbeeld afdrukken (1 pagina, kleur)?" "Afdrukken" "Stoppen"
IF NOT "$APSkeuze" EQ "1"
  Quit 5
EndIF
IF NOT EXISTS SYS:Rexxc/RX
  Echo "FOUT: SYS:Rexxc/RX ontbreekt."
  Quit 20
EndIF
Status >NIL: COMMAND=SYS:System/RexxMast
IF WARN
  Run >NIL: SYS:System/RexxMast
  Wait 2
EndIF
Run >NIL: SYS:Utilities/MultiView TestBeeld.iff PORTNAME APSVIEW
Set n 0
Lab w
Wait 1
SYS:Rexxc/RX >NIL: "IF SHOW('P','APSVIEW') THEN EXIT 0; EXIT 5"
IF NOT WARN
  Skip klaar
EndIF
Set n `Eval $n + 1`
IF NOT $n GE 60 VAL
  Skip w BACK
EndIF
Echo "FOUT: MultiView opende niet binnen 60 s."
Quit 20
Lab klaar
Echo "MultiView drukt af..."
SYS:Rexxc/RX "ADDRESS APSVIEW; PRINT; QUIT"
; wachten tot MultiView echt weg is (printer.device is exclusief)
Set n 0
Lab q
Wait 1
SYS:Rexxc/RX >NIL: "IF SHOW('P','APSVIEW') THEN EXIT 5; EXIT 0"
IF NOT WARN
  Skip weg
EndIF
Set n `Eval $n + 1`
IF NOT $n GE 900 VAL
  Skip q BACK
EndIF
Lab weg
Echo "OK: afdrukopdracht gegeven. Controleer de printer."
