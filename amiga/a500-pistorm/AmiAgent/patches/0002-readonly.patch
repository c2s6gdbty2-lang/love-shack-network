+#ifdef AMIAGENT_READONLY
+/* ------------------------------------------------------------------ *
+ * LSN 0002: READONLY build (The Love Shack Network).
+ *
+ * Compiled in, not a switch: this binary cannot be talked into writing.
+ * Every channel that can change the machine is closed in the agent itself,
+ * so safety does not depend on the client-side filter alone:
+ *   - PUT (file write), AREXX (arbitrary programs), INPUT and UIACT
+ *     (mouse/keyboard/gadgets/menus), BREAK (Ctrl-C to other processes):
+ *     refused before they reach their handler.
+ *   - EXEC: only the exact words below, without arguments; the agent then
+ *     runs its own fixed command line, so client text never reaches the
+ *     shell (no redirection, no second command, no FLUSH).
+ *   - GET/GETRANGE: only real files on a filesystem (Lock + Examine +
+ *     OpenFromLock), never a handler such as CON:, SER: or PIPE:.
+ *   - local ARexx port: ACTIVATEWINDOW, ENTERTEXT/TYPE, KEY, TASKPRI refused.
+ * ------------------------------------------------------------------ */
+#define AMIAGENT_LSN "lsn1 READONLY"
+static const struct { const char *word; const char *cmd; } ro_cmds[] = {
+    { "Avail",      "C:Avail" },
+    { "Version",    "C:Version" },
+    { "ShowConfig", "SYS:Tools/ShowConfig" },
+};
+
+static int ro_ieq(const UBYTE *p, ULONG len, const char *w)
+{
+    ULONG i;
+    if (len != (ULONG)strlen(w)) return 0;
+    for (i = 0; i < len; i++) {
+        UBYTE a = p[i], b = (UBYTE)w[i];
+        if (a >= 'a' && a <= 'z') a -= 32;
+        if (b >= 'a' && b <= 'z') b -= 32;
+        if (a != b) return 0;
+    }
+    return 1;
+}
+
+static const char *ro_lookup(const UBYTE *p, ULONG len)
+{
+    ULONG i;
+    for (i = 0; i < sizeof ro_cmds / sizeof ro_cmds[0]; i++)
+        if (ro_ieq(p, len, ro_cmds[i].word)) return ro_cmds[i].cmd;
+    return NULL;
+}
+
+static int ro_blocked(UBYTE code)
+{
+    return code == 0x04 /* PUT */ || code == 0x12 /* AREXX */ ||
+           code == 0x08 /* INPUT */ || code == 0x0E /* UIACT */ ||
+           code == 0x09 /* BREAK */;
+}
+#else
+#define AMIAGENT_LSN "lsn1"
+#endif
