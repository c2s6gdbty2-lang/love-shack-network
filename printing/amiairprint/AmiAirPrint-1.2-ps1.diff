+/*
+ * AirPrintPS (A500 PiStorm): printer.device onder OS 3.1 roept dit device aan
+ * vanuit zijn eigen exec-TASK. DOS-aanroepen uit een Task blijven daar hangen,
+ * dus prefs worden alleen in een Process (OpenDevice, opener-context) van schijf
+ * gelezen en in een Task uit deze cache gehaald; de spool staat in het geheugen.
+ */
+static struct APDPreferences g_prefs_cache;
+static int g_prefs_cache_valid;
+
+static int apd_in_process(void)
+{
+    return FindTask(NULL)->tc_Node.ln_Type == NT_PROCESS;
+}
+
+static int apd_load_prefs_disk(struct APDPreferences *prefs);
+
 static int apd_load_prefs(struct APDPreferences *prefs)
+{
+    if (apd_in_process()) {
+        int ok = apd_load_prefs_disk(prefs);
+        if (ok) {
+            g_prefs_cache = *prefs;
+            g_prefs_cache_valid = 1;
+        }
+        return ok;
+    }
+    if (!g_prefs_cache_valid) return 0;
+    *prefs = g_prefs_cache;
+    return 1;
+}
+
