+/* LSN 0002: open for reading. In the READONLY build only an existing file on
+ * a filesystem qualifies: Lock() fails on handlers like CON:, RAW:, SER:,
+ * PAR:, PRT: or PIPE: (which would open a window or consume data), and a
+ * directory is refused before anything is opened. */
+static BPTR ro_open(const char *path)
+{
+#ifdef AMIAGENT_READONLY
+    BPTR lock = Lock((STRPTR)path, ACCESS_READ), fh;
+    struct FileInfoBlock *fib;
+    if (!lock) return 0;
+    fib = (struct FileInfoBlock *)AllocDosObject(DOS_FIB, NULL);
+    if (!fib || !Examine(lock, fib) || fib->fib_DirEntryType >= 0) {
+        if (fib) FreeDosObject(DOS_FIB, fib);
+        UnLock(lock);
+        SetIoErr(ERROR_OBJECT_WRONG_TYPE);
+        return 0;
+    }
+    FreeDosObject(DOS_FIB, fib);
+    fh = OpenFromLock(lock);
+    if (!fh) UnLock(lock);
+    return fh;
+#else
+    return Open((STRPTR)path, MODE_OLDFILE);
+#endif
+}
